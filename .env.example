# Alpaca paper-account credentials. Keep real values in .env only.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# This portfolio build accepts paper mode only.
PAPER=true
ALPACA_DATA_FEED=iex

# Logging and local state
LOG_LEVEL=INFO
STATE_PATH=./ffb_state.json
BOT_TAG=ffb

# Strategy
TIMEFRAME_MIN=5
EMA_SHORT=20
EMA_LONG=50
VOL_EMA_LEN=50
LOOKBACK_DAYS=3
STALE_MINUTES=15
RSI_FILTER=false
RSI_LEN=14
RSI_MAX=70
VOLUME_FILTER_ENABLED=true
ETF_VOLUME_BYPASS=true
VOL_RELAX_MULT=0.60

# Risk controls
RISK_BUDGET_TOTAL=0.01
MAX_OPEN_POSITIONS=6
TRAIL_PERCENT=1.0
ENTRY_TIF=day
TRAIL_TIF=gtc
MAX_NEW_BUYS_PER_BUCKET=3
MIN_QTY=1
MIN_NOTIONAL=50.0
MAX_SYMBOL_CASH_PCT=0.08
DAILY_LOSS_LIMIT_PCT=0.02
DAILY_LOSS_LIMIT_USD=0.0
DAILY_LOSS_MODE=halt_entries
TRADING_DAY_TZ=America/New_York

# Polling
SLEEP_SECONDS=15
CLOSED_SLEEP_SECONDS=60
UPDATE_EVERY_SEC=60
TELEMETRY_EVERY_SEC=60
POSITIONS_SYNC_EVERY_SEC=30
ORDERS_SYNC_EVERY_SEC=30
